{
  "name": "anime-desktop-buddy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.desktopbuddy.anime",
    "productName": "Anime Desktop Buddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "sass": "^1.105.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "lucide-react": "^1.59.0",
    "openai": "^7.36.0",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  }
}
